# Copy to .env ONLY for running on your own computer. NEVER commit .env.
# On GitHub, put these values in Settings > Secrets and variables > Actions instead.

# Optional: Google Search Console (paste the WHOLE service-account JSON on one line)
GSC_SERVICE_ACCOUNT_JSON=
# Examples: sc-domain:examdarpan.in   or   https://examdarpan.in/
GSC_SITE_URL=

# Optional: AI suggestions (provider/model are chosen in config.yaml)
AI_API_KEY=
